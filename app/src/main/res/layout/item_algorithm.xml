<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Category Icon Container -->
    <FrameLayout
        android:id="@+id/layout_icon_container"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/card_background"
        android:backgroundTint="#1822D3EE">

        <ImageView
            android:id="@+id/iv_algo_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_zap"
            app:tint="@color/primary_cyan" />
    </FrameLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_algo_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bubble Sort"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_explore"
                app:tint="@color/nav_inactive" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_algo_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="O(n²)"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="2dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/divider_color" />

            <TextView
                android:id="@+id/tv_algo_difficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:backgroundTint="#1A4ADE80"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="Easy"
                android:textColor="@color/success_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
