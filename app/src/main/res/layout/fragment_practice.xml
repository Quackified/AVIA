<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 1. HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Practice Mode: QuickSort"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Progress indicator -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Question 3 of 5"
                    android:textColor="@color/text_secondary"
                    android:textSize="8.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="60%"
                    android:textColor="@color/primary_cyan"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <ProgressBar
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progress="60"
                android:progressTint="@color/primary_cyan" />
        </LinearLayout>

        <!-- 2. FROZEN VISUALIZER CANVAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="10dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 4 · QUICKSORT PARTITION"
                    android:textColor="@color/text_muted"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/chip_background_selector"
                    android:backgroundTint="#1F8B5CF6"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="Frozen Canvas"
                    android:textColor="@color/secondary_purple"
                    android:textSize="8sp" />
            </RelativeLayout>

            <com.example.algolens.ui.visualizer.BarVisualizerView
                android:id="@+id/practice_visualizer"
                android:layout_width="match_parent"
                android:layout_height="100dp" />
        </LinearLayout>

        <!-- 3. QUESTION CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUESTION"
                    android:textColor="@color/text_muted"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/chip_background_selector"
                    android:backgroundTint="#1AFB923C"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="Medium"
                    android:textColor="@color/accent_orange"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Which element will be swapped with the pivot (89) in the next step?"
                android:textColor="@color/text_primary"
                android:textSize="10.5sp"
                android:lineSpacingMultiplier="1.45" />
        </LinearLayout>

        <!-- 4. MULTIPLE CHOICE OPTIONS -->
        <LinearLayout
            android:id="@+id/layout_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <!-- Options will be added dynamically or hardcoded for this demo -->
            <TextView
                android:id="@+id/btn_option_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/option_button_selector"
                android:padding="10dp"
                android:text="Index 1 (Value: 45)"
                android:textColor="@color/text_primary"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_option_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/option_button_selector"
                android:padding="10dp"
                android:text="Index 4 (Value: 34)"
                android:textColor="@color/text_primary"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_option_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/option_button_selector"
                android:padding="10dp"
                android:text="Index 2 (Value: 23)"
                android:textColor="@color/text_primary"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/chip_background_selector"
            android:backgroundTint="@color/primary_cyan"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="Submit Answer"
            android:textColor="@color/bg_dark"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- 5. FEEDBACK OVERLAY -->
        <LinearLayout
            android:id="@+id/layout_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:backgroundTint="#1A4ADE80"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_background_selector"
                    android:backgroundTint="@color/success_green" />

                <TextView
                    android:id="@+id/tv_feedback_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correct! Excellent partition analysis."
                    android:textColor="@color/success_green"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_feedback_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Index 4 (value 34) is the final smaller element scanned from right. Swapping 34 with pivot 89 correctly places 89 into its sorted partition slot."
                android:textColor="@color/text_primary"
                android:textSize="9sp"
                android:lineSpacingMultiplier="1.5" />

            <TextView
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_background_selector"
                android:backgroundTint="@color/success_green"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Next Question →"
                android:textColor="@color/bg_dark"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
