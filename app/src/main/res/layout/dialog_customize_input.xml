<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:backgroundTint="#0C1526"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customize Input"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:padding="4dp"
            android:text="✕"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- Custom Values Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Array Values (comma-separated):"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_input_values"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/card_background"
        android:backgroundTint="#060A14"
        android:fontFamily="@font/jetbrains_mono"
        android:hint="e.g. 64, 34, 25, 12"
        android:padding="12dp"
        android:textColor="@color/primary_cyan"
        android:textColorHint="@color/text_muted"
        android:textSize="12sp"
        android:inputType="text" />

    <!-- Presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Preset Configurations:"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_preset_random"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/card_background"
            android:backgroundTint="#14FFFFFF"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="Random"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_preset_sorted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/card_background"
            android:backgroundTint="#14FFFFFF"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="Sorted"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_preset_reverse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/card_background"
            android:backgroundTint="#14FFFFFF"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="Reverse"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Array Length -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Array Length:"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_length_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="7 elements"
            android:textColor="@color/primary_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <SeekBar
        android:id="@+id/sb_length"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:max="10"
        android:progress="2"
        android:progressTint="@color/primary_cyan"
        android:thumbTint="@color/primary_cyan" />

    <!-- Apply Button -->
    <TextView
        android:id="@+id/btn_apply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/chip_background_selector"
        android:backgroundTint="@color/primary_cyan"
        android:elevation="4dp"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="Apply &amp; Reset Visualizer"
        android:textColor="@color/bg_dark"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
