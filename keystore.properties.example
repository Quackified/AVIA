# Copy to keystore.properties and fill in your existing signing key details.
# Use forward slashes for Windows paths. Relative paths start at the project root.
# Escape backslashes as \\ in passwords (Java .properties format).
storeFile=C:/path/to/avia-release.jks
storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD
keyAlias=REPLACE_WITH_YOUR_KEY_ALIAS
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
